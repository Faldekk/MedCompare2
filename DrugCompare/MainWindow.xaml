<Window x:Class="DrugCompare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chplNavigator="clr-namespace:DrugCompare.Features.ChPLNavigator"
        xmlns:interactionChecker="clr-namespace:DrugCompare.Features.InteractionChecker"
        xmlns:polishRegistry="clr-namespace:DrugCompare.Features.PolishRegistry"
        xmlns:icdLooker="clr-namespace:DrugCompare.Features.IcdLooker"
        xmlns:evidenceAssistant="clr-namespace:DrugCompare.Features.EvidenceAssistant"
        Title="ClinicDaddy"
        Height="900"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Window.Resources>

        <Style x:Key="CardStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#DDE3EA"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="10"/>
            <Setter Property="Padding"
                    Value="18"/>
            <Setter Property="Margin"
                    Value="0,0,0,14"/>
        </Style>

        <Style x:Key="MutedTextStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#607D8B"/>
            <Setter Property="FontSize"
                    Value="13"/>
        </Style>

        <Style x:Key="NavButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="Margin"
                    Value="0,2,0,2"/>
            <Setter Property="Padding"
                    Value="10,0"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Foreground"
                    Value="#263238"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

        <Style x:Key="CollapsedNavButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="Margin"
                    Value="0,2,0,2"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn"
                              Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT NAVIGATION -->
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#DDE3EA"
                BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Content="☰"
                        Height="42"
                        Margin="10"
                        FontSize="18"
                        Click="ToggleNavigation_Click"/>

                <!-- Expanded navigation -->
                <ScrollViewer x:Name="ExpandedNavigation"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="18,0,18,0">

                        <TextBlock Text="ClinicDaddy"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#102027"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="Offline Clinical Decision Support"
                                   FontSize="12"
                                   Foreground="#607D8B"
                                   Margin="0,0,0,20"/>

                        <Expander Header="Clinical Tools"
          IsExpanded="True"
          Margin="0,0,0,8">
                            <StackPanel Margin="0,8,0,0">

                                <Button Style="{StaticResource NavButtonStyle}"
                Content="🔎  Evidence Assistant"
                Tag="0"
                Click="Navigate_Click"/>

                                <Button Style="{StaticResource NavButtonStyle}"
                Content="📄  ChPL Navigator"
                Tag="1"
                Click="Navigate_Click"/>

                                <Button Style="{StaticResource NavButtonStyle}"
                Content="⚕  Interaction Checker"
                Tag="2"
                Click="Navigate_Click"/>

                                <Button Style="{StaticResource NavButtonStyle}"
                Content="R  Polski Rejestr Leków"
                Tag="3"
                Click="Navigate_Click"/>

                                <Button Style="{StaticResource NavButtonStyle}"
                Content="ICD  ICD Looker"
                Tag="4"
                Click="Navigate_Click"/>

                            </StackPanel>
                        </Expander>

                    

                        <Expander Header="Database"
                                  IsExpanded="True"
                                  Margin="0,0,0,8">
                            <StackPanel Margin="0,8,0,0">

                                <Button Style="{StaticResource NavButtonStyle}"
                                        Content="🗄  Data Management"
                                        Tag="5"
                                        Click="Navigate_Click"/>

                            </StackPanel>
                        </Expander>

                        <Expander Header="System"
                                  IsExpanded="False"
                                  Margin="0,0,0,8">
                            <StackPanel Margin="0,8,0,0">

                                <Button Style="{StaticResource NavButtonStyle}"
                                        Content="🧾  Audit Log"
                                        Tag="6"
                                        Click="Navigate_Click"/>

                                <Button Style="{StaticResource NavButtonStyle}"
                                        Content="🕘  History"
                                        Tag="7"
                                        Click="Navigate_Click"/>

                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>

                <!-- Collapsed navigation -->
                <StackPanel x:Name="CollapsedNavigation"
                            Grid.Row="1"
                            Visibility="Collapsed"
                            Margin="8,0,8,0">

                    <Button Style="{StaticResource CollapsedNavButtonStyle}"
        Content="🔎"
        ToolTip="Evidence Assistant"
        Tag="0"
        Click="Navigate_Click"/>

                    <Button Style="{StaticResource CollapsedNavButtonStyle}"
        Content="📄"
        ToolTip="ChPL Navigator"
        Tag="1"
        Click="Navigate_Click"/>

                    <Button Style="{StaticResource CollapsedNavButtonStyle}"
        Content="⚕"
        ToolTip="Interaction Checker"
        Tag="2"
        Click="Navigate_Click"/>

                    <Button Style="{StaticResource CollapsedNavButtonStyle}"
        Content="R"
        ToolTip="Polski Rejestr Leków"
        Tag="3"
        Click="Navigate_Click"/>

                    <Button Style="{StaticResource CollapsedNavButtonStyle}"
        Content="ICD"
        ToolTip="ICD Looker"
        Tag="4"
        Click="Navigate_Click"/>

                    <Button Style="{StaticResource CollapsedNavButtonStyle}"
        Content="🗄"
        ToolTip="Data Management"
        Tag="5"
        Click="Navigate_Click"/>

                    <Button Style="{StaticResource CollapsedNavButtonStyle}"
        Content="🧾"
        ToolTip="Audit Log"
        Tag="6"
        Click="Navigate_Click"/>

                    <Button Style="{StaticResource CollapsedNavButtonStyle}"
        Content="🕘"
        ToolTip="History"
        Tag="7"
        Click="Navigate_Click"/>

                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="Brak danych nie oznacza bezpieczeństwa klinicznego."
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="#78909C"
                           Margin="18,14,18,18"/>

            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <TabControl x:Name="MainTabs"
                    Grid.Column="1"
                    Margin="22"
                    BorderThickness="0"
                    Background="Transparent">

            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility"
                            Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>
            
            <!-- 0 Evidence Assistant -->
            <TabItem>
                <evidenceAssistant:EvidenceAssistantView DataContext="{Binding EvidenceAssistant}"/>
            </TabItem>
            <!-- 1 ChPL Navigator -->
            <TabItem>
                <chplNavigator:ChPLNavigatorView DataContext="{Binding ChPLNavigator}"/>
            </TabItem>

            <!-- 2 Interaction Checker -->
            <TabItem>
                <interactionChecker:InteractionCheckerView DataContext="{Binding InteractionChecker}"/>
            </TabItem>

            <!-- 3 Polish Registry -->
            <TabItem>
                <polishRegistry:PolishRegistryView
                    DataContext="{Binding DataContext.PolishDrugRegistry, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </TabItem>

            <!-- 4 ICD Looker -->
            <TabItem>
                <icdLooker:IcdLookerView DataContext="{Binding IcdLooker}"/>
            </TabItem>

            <!-- 5 Data Management -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Knowledge Base Search"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

                                <DockPanel Margin="0,0,0,12">
                                    <Button Content="Szukaj"
                    Command="{Binding SearchKnowledgeBaseCommand}"
                    Height="34"
                    Width="90"
                    DockPanel.Dock="Right"
                    Margin="8,0,0,0"/>

                                    <TextBox Text="{Binding KnowledgeSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Height="34"
                     VerticalContentAlignment="Center"/>
                                </DockPanel>

                                <TextBlock Text="{Binding KnowledgeSearchStatus}"
                   Foreground="#607D8B"
                   Margin="0,0,0,12"/>

                                <DataGrid ItemsSource="{Binding KnowledgeSearchResults}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  MaxHeight="360">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Source"
                                    Binding="{Binding SourceTitle}"
                                    Width="220"/>

                                        <DataGridTextColumn Header="Section"
                                    Binding="{Binding SectionNumber}"
                                    Width="80"/>

                                        <DataGridTextColumn Header="Status"
                                    Binding="{Binding ReviewStatus}"
                                    Width="120"/>

                                        <DataGridTextColumn Header="Text"
                                    Binding="{Binding ChunkText}"
                                    Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Data Management"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#102027"
                                   Margin="0,0,0,18"/>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Database Status"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>

                                <UniformGrid Columns="3">

                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Drugs"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{Binding DrugCount}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Active substances"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{Binding ActiveSubstanceCount}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="Interactions"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{Binding InteractionCount}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                </UniformGrid>

                                <Button Content="Odśwież status bazy"
                                        Command="{Binding LoadDatabaseStatusCommand}"
                                        Height="34"
                                        Width="170"
                                        HorizontalAlignment="Left"
                                        Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Knowledge Base"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>

                                <UniformGrid Columns="3">

                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="ChPL documents"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{Binding ChplDocumentCount}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="ChPL sections"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{Binding ChplSectionCount}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="Knowledge chunks"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{Binding KnowledgeChunkCount}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                </UniformGrid>

                                <UniformGrid Columns="3"
                                             Margin="0,16,0,0">

                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Needs review"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{Binding NeedsReviewChunkCount}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Reviewed"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{Binding ReviewedChunkCount}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="Verified"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{Binding VerifiedChunkCount}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                </UniformGrid>

                                <Button Content="Odśwież Knowledge Base"
                                        Command="{Binding LoadKnowledgeBaseStatsCommand}"
                                        Height="34"
                                        Width="190"
                                        HorizontalAlignment="Left"
                                        Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Data Imports"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>

                                <TextBlock Text="Import danych jest obecnie wyłączony w trybie SQLite-only. Aktualizacje będą później realizowane przez lokalne paczki danych."
                                           TextWrapping="Wrap"
                                           Foreground="#607D8B"/>

                                <Button Content="Odśwież Data Management"
                                        Command="{Binding LoadDataManagementCommand}"
                                        Height="34"
                                        Width="200"
                                        HorizontalAlignment="Left"
                                        Margin="0,16,0,0"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Utwórz kopię bazy"
                                            Command="{Binding CreateDatabaseBackupCommand}"
                                            Height="34" Margin="0,0,8,0"/>
                                    <Button Content="Przywróć kopię bazy"
                                            Command="{Binding RestoreDatabaseBackupCommand}"
                                            Height="34"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 6 Audit Log -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Audit Log"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#102027"
                                   Margin="0,0,0,18"/>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>

                                <Button Content="Odśwież Audit Log"
                                        Command="{Binding LoadAuditLogsCommand}"
                                        Height="34"
                                        Width="160"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12"/>

                                <DataGrid ItemsSource="{Binding AuditLogs}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time"
                                                            Binding="{Binding CreatedAt}"
                                                            Width="180"/>
                                        <DataGridTextColumn Header="Action"
                                                            Binding="{Binding Action}"
                                                            Width="180"/>
                                        <DataGridTextColumn Header="Details"
                                                            Binding="{Binding Details}"
                                                            Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 7 History -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Interaction History"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#102027"
                                   Margin="0,0,0,18"/>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>

                                <Button Content="Odśwież historię"
                                        Command="{Binding LoadHistoryCommand}"
                                        Height="34"
                                        Width="150"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12"/>

                                <DataGrid ItemsSource="{Binding InteractionHistory}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time"
                                                            Binding="{Binding CheckedAt}"
                                                            Width="180"/>
                                        <DataGridTextColumn Header="Substances"
                                                            Binding="{Binding SubstanceNames}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="Result"
                                                            Binding="{Binding ResultSummary}"
                                                            Width="260"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
